function NfcTab() {
  const [state, setState] = useState("ready");
  const timers = useRef([]);
  useEffect(() => () => timers.current.forEach(clearTimeout), []);
  const tap = () => {
    if (state !== "ready") return;
    setState("reading");
    timers.current.push(setTimeout(() => setState("open"), 900), setTimeout(() => setState("ready"), 4200));
  };
  const open = state === "open";
  return (
    <div className="flex flex-col items-center pt-2 text-center">
      <h3 className="slab text-[20px] font-bold">Main Lobby Gate</h3>
      <p className="text-[14px] text-[#55655f]">Hold your phone to the reader</p>
      <button onClick={tap} aria-label="Tap to unlock" className="relative my-8 grid h-44 w-44 place-items-center rounded-full">
        {state !== "open" && [0, 0.6, 1.2].map(d => <span key={d} className="ring absolute inset-0 rounded-full border-2" style={{ borderColor: C.green, animationDelay: `${d}s`, animationDuration: state === "reading" ? ".7s" : "1.8s" }} />)}
        <motion.span animate={{ scale: state === "reading" ? 0.92 : 1, backgroundColor: open ? C.green : "#ffffff" }} className="relative grid h-36 w-36 place-items-center rounded-full shadow-[0_12px_30px_-10px_rgba(2,42,42,.4)]">
          {open ? <Check size={56} color="#fff" strokeWidth={2.5} /> : <Nfc size={52} color={C.green} />}
        </motion.span>
      </button>
      <div className="h-6 text-[16px] font-bold" style={{ color: open ? C.green : C.ink }}>{state === "ready" ? "Tap the circle" : state === "reading" ? "Reading key…" : "Unlocked · welcome home"}</div>
      <MiniGate open={open} />
      <div className="mt-4 w-full rounded-2xl bg-white p-3 text-left ring-1 ring-[#dfe5e0]">
        <div className="flex items-center gap-2 text-[14px] font-bold"><KeyRound size={16} color={C.brass} />Resident · full access</div>
        <div className="mono mt-1 text-[14px] text-[#55655f]">NFC-9902-331</div>
      </div>
    </div>
  );
}

function SosButton({ icon: Icon, title, sub }) {
  const [p, setP] = useState(0);
  const [done, setDone] = useState(false);
  const raf = useRef();
  const start = () => { if (done) return; const t0 = performance.now(); const step = (now) => { const v = Math.min(1, (now - t0) / 1200); setP(v); if (v < 1) raf.current = requestAnimationFrame(step); else { setDone(true); setTimeout(() => { setDone(false); setP(0); }, 2600); } }; raf.current = requestAnimationFrame(step); };
  const stop = () => { cancelAnimationFrame(raf.current); if (!done) setP(0); };
  return (
    <button onPointerDown={start} onPointerUp={stop} onPointerLeave={stop} onKeyDown={e => (e.key === " " || e.key === "Enter") && !e.repeat && start()} onKeyUp={stop}
      className="relative overflow-hidden rounded-2xl p-3 text-left text-white select-none touch-none" style={{ background: C.rust }}>
      <span className="absolute inset-y-0 left-0 bg-black/25" style={{ width: `${p * 100}%` }} />
      <span className="relative block"><Icon size={20} /><span className="mt-1 block text-[14px] font-bold">{done ? "Calling…" : title}</span><span className="block text-[14px] opacity-80">{done ? sub : "Hold to call"}</span></span>
    </button>
  );
}

