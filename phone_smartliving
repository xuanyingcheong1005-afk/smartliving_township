function hash(str) { let h = 2166136261; for (const ch of str) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; }
function PassCode({ seed, size = 132 }) {
  const N = 23;
  const cells = useMemo(() => {
    let h = hash(seed); const out = [];
    const finder = (r, c) => { for (const [fr, fc] of [[0, 0], [0, N - 7], [N - 7, 0]]) { const y = r - fr, x = c - fc; if (y >= 0 && y < 7 && x >= 0 && x < 7) return (y === 0 || y === 6 || x === 0 || x === 6 || (y > 1 && y < 5 && x > 1 && x < 5)) ? 1 : 0; if (y >= -1 && y <= 7 && x >= -1 && x <= 7) return 0; } return null; };
    for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) { const f = finder(r, c); if (f !== null) { if (f) out.push([r, c]); continue; } h ^= h << 13; h ^= h >>> 17; h ^= h << 5; h >>>= 0; if (h % 100 < 47) out.push([r, c]); }
    return out;
  }, [seed]);
  return (
    <svg viewBox={`-1 -1 ${N + 2} ${N + 2}`} width={size} height={size} aria-label="Visitor pass code">
      <rect x="-1" y="-1" width={N + 2} height={N + 2} fill="#fff" />
      {cells.map(([r, c]) => <rect key={`${r}-${c}`} x={c} y={r} width="1.02" height="1.02" fill={C.ink} />)}
    </svg>
  );
}

