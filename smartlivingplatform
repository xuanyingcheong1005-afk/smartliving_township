function Slider({ id, label, v, set, min, max, step, unit }) {
  return (
    <div>
      <div className="flex items-baseline justify-between"><label htmlFor={id} className="text-[16px] font-medium text-white/80">{label}</label><span className="slab text-[24px] font-bold">{v.toLocaleString()} <span className="text-[16px] font-medium text-white/80">{unit}</span></span></div>
      <input id={id} type="range" min={min} max={max} step={step} value={v} onChange={e => set(+e.target.value)} className="mt-3 w-full" />
    </div>
  );
}

function Savings() {
  const [units, setUnits] = useState(350);
  const [visits, setVisits] = useState(12);
  const monthly = units * visits;
  const out = [
    [(monthly * 12).toLocaleString(), "paper slips saved a year"],
    [`${Math.round((monthly * 2.5) / 60).toLocaleString()} hrs`, "guard time freed a month"],
    [`RM ${Math.round(units * 22).toLocaleString()}`, "admin cost saved a month"],
  ];
  return (
    <section id="savings" className="scroll-mt-16 px-5 pb-20 md:pb-28">
      <div className="mx-auto grid max-w-[1112px] gap-10 rounded-[32px] bg-[#184948] p-8 text-white md:grid-cols-2 md:p-14">
        <div>
          <h2 className="slab text-[36px] font-extrabold leading-tight sm:text-[44px]">What your township gets back.</h2>
          <div className="mt-10 space-y-8">
            <Slider id="u" label="Housing units" v={units} set={setUnits} min={50} max={2000} step={10} unit="units" />
            <Slider id="vi" label="Visitors per unit, monthly" v={visits} set={setVisits} min={2} max={50} step={1} unit="visits" />
          </div>
        </div>
        <div className="flex flex-col justify-center gap-4">
          {out.map(([n, l]) => (
            <div key={l} className="rounded-2xl bg-[#022a2a]/40 px-6 py-5">
              <div className="slab text-[40px] font-extrabold leading-none text-[#eeba67]">{n}</div>
              <div className="mt-1.5 text-[16px] text-white/85">{l}</div>
            </div>
          ))}
          <p className="text-[14px] text-white/80">Assumes one slip per visit, 2.5 min saved per gate check, RM 22 admin cost per unit.</p>
        </div>
      </div>
    </section>
  );
}

