@import url("https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@500;700;800&family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@500;700&display=swap");
html { scroll-behavior: smooth; }
body { margin: 0; background: #eef1ec; color: #022a2a; font-family: Roboto, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
.slab { font-family: "Roboto Slab", Georgia, serif; }
.mono { font-family: "Roboto Mono", ui-monospace, monospace; }
.plate { font-family: "Roboto Mono", monospace; font-weight: 700; background: #0b0f0f; color: #f4f4ef; border-radius: 4px; letter-spacing: .08em; box-shadow: inset 0 0 0 1.5px #3a4242; }
.stripes { background: repeating-linear-gradient(90deg, #944839 0 22px, #f4efe6 22px 44px); }
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { scrollbar-width: none; }
@keyframes sway { 0%,100% { transform: rotate(-1.2deg) } 50% { transform: rotate(1.2deg) } }
.sway { transform-box: fill-box; transform-origin: 50% 100%; animation: sway 6s ease-in-out infinite; }
@keyframes ring { 0% { transform: scale(.7); opacity: .7 } 100% { transform: scale(1.9); opacity: 0 } }
.ring { animation: ring 1.8s ease-out infinite; }
@keyframes beam { 0%,100% { opacity: .08 } 50% { opacity: .28 } }
.beam { animation: beam .5s ease-in-out infinite; }
input[type=range] { accent-color: #c08e39; }
:focus-visible { outline: 3px solid #c08e39; outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { .sway, .ring, .beam { animation: none } html { scroll-behavior: auto } }
